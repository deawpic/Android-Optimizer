# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets & Environment variables
.env
.env.local

# Harness Cache & Telemetry Logs (Preserve directory structure)
cache/*.db
cache/*.db-wal
cache/*.db-shm
cache/*.log
cache/*.txt
!cache/.gitkeep

# Output artifacts (Keep reports, ignore raw screenshots & dumps)
output/*.png
output/*.xml
output/*.log
!output/*.md
!output/.gitkeep
